{
  "name": "cliproxy-management-ui",
  "private": true,
  "version": "1.27.3-subscription.1",
  "description": "CLIProxyAPI management panel (based on router-for-me/Cli-Proxy-API-Management-Center v1.27.3) with pooled subscription quota charts.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "eslint . --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@noble/hashes": "^2.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "1.20.0",
    "i18next": "^26.5.4",
    "motion": "^12.42.2",
    "motion-dom": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.4",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun": "^1.4.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
